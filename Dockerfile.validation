# Build with: docker build --platform=linux/amd64 -f Dockerfile.validation -t armadalive-validation .
# This is a validation image, not an Armada OS or hardware emulator.
ARG PYTHON_IMAGE=python:3.12-slim-bookworm
FROM ${PYTHON_IMAGE}

# PySide6 6.12.0's arm64 wheel needs newer glibc than Bookworm supplies.
RUN test "$(uname -m)" = x86_64 || \
    { echo 'Build this validation image with --platform=linux/amd64' >&2; exit 1; }

RUN apt-get update && apt-get install -y --no-install-recommends \
        bash coreutils fonts-dejavu-core \
        libatomic1 libdbus-1-3 libegl1 libfontconfig1 libfreetype6 \
        libgl1 libglib2.0-0 libgssapi-krb5-2 libopengl0 libxkbcommon0 libzstd1 \
    && rm -rf /var/lib/apt/lists/*

# Match the local validation environment. Binary-only installation fails clearly
# if the selected platform cannot use these wheels; it never builds Qt itself.
RUN python -m pip install --no-cache-dir --only-binary=:all: \
        PySide6==6.12.0 PyMuPDF==1.26.6 \
    && python -m pip check

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONFAULTHANDLER=1 \
    QT_QPA_PLATFORM=offscreen \
    QT_QUICK_BACKEND=software \
    QT_SCALE_FACTOR=1 \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# Verify that the wheel dependencies can be loaded during an actual build.
RUN python -c 'from PySide6 import QtCore, QtGui, QtQml, QtQuick, QtTest, QtDBus, QtWebSockets; import pymupdf; app = QtGui.QGuiApplication([]); window = QtQuick.QQuickWindow(); print("Qt", QtCore.qVersion())'

WORKDIR /app
COPY armadalive/ /app/armadalive/
COPY scripts/ /app/scripts/
COPY tests/ /app/tests/
COPY install.sh LICENSE /app/
RUN groupadd --gid 10001 validator \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /tmp/validator validator \
    && mkdir /reports \
    && chown 10001:10001 /reports \
    && chmod -R a-w /app

USER 10001:10001
ENTRYPOINT ["/bin/bash", "/app/scripts/validate-container.sh"]
CMD ["/reports"]
